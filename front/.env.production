# No build-time secrets here on purpose.
# Set these in Vercel → Project → Settings → Environment Variables
# (do NOT commit them here, or they'd override Vercel's values):
#   VITE_SUPABASE_URL=https://<your-project>.supabase.co
#   VITE_SUPABASE_ANON_KEY=<your anon public key>
#
# For local dev/build, create front/.env.local with the same two vars.
