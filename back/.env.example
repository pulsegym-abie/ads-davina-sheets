APP_NAME="Ads Analytics"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ads-performance.pulsepowerhub.id
FRONTEND_URL=https://ads-performance.pulsepowerhub.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# aaPanel MySQL — create the DB in aaPanel, then fill these in.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ads_pulsepowerhub
DB_USERNAME=ads_pulsepowerhub
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google Login OAuth (SSO) — create an OAuth client in Google Cloud Console.
# Authorized redirect URI must match GOOGLE_LOGIN_REDIRECT_URI below exactly.
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=https://ads-performance.pulsepowerhub.id/api/auth/google/callback

# Google Ads API (optional — only for live sync, not needed for the sheets demo)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
